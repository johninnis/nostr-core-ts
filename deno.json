{
  "name": "@innis/nostr-core",
  "version": "0.2.2",
  "license": "MIT",
  "description": "TypeScript foundation primitives for Nostr: branded types, event helpers, Signer + HttpClient ports, NIP-17 DMs, NIP-98 HTTP auth, and a Result/TaggedError model.",
  "exports": {
    ".": "./mod.ts",
    "./testing": "./testing.ts"
  },
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true
  },
  "imports": {
    "@std/assert": "jsr:@std/assert@^1",
    "@std/path": "jsr:@std/path@^1",
    "@scure/base": "npm:@scure/base@^2",
    "@noble/curves/secp256k1": "npm:@noble/curves@^2/secp256k1.js",
    "@noble/hashes/hkdf": "npm:@noble/hashes@^2/hkdf.js",
    "@noble/hashes/hmac": "npm:@noble/hashes@^2/hmac.js",
    "@noble/hashes/sha2": "npm:@noble/hashes@^2/sha2.js",
    "@noble/hashes/utils": "npm:@noble/hashes@^2/utils.js",
    "@noble/ciphers/aes": "npm:@noble/ciphers@^2/aes.js",
    "@noble/ciphers/chacha": "npm:@noble/ciphers@^2/chacha.js",
    "@noble/ciphers/utils": "npm:@noble/ciphers@^2/utils.js"
  },
  "tasks": {
    "check": "deno check mod.ts testing.ts src/ tests/",
    "lint": "deno lint",
    "fmt": "deno fmt",
    "fmt:check": "deno fmt --check",
    "test": "deno test -A",
    "coverage": "rm -rf cov_profile && deno test -A --coverage=cov_profile && deno coverage cov_profile --lcov --output=cov_profile/lcov.info && deno coverage cov_profile && deno run --allow-read scripts/check-coverage.ts",
    "exports-tested": "deno run --allow-read --allow-run scripts/check-exports-tested.ts",
    "publish:dry": "deno publish --dry-run",
    "ci": "deno task fmt:check && deno task lint && deno task check && deno task coverage && deno task exports-tested"
  },
  "lint": {
    "plugins": ["./scripts/lint-plugins/innis-rules.ts"],
    "rules": {
      "include": ["no-console", "ban-untagged-todo", "explicit-function-return-type", "no-non-null-assertion"],
      "exclude": ["require-await"]
    },
    "exclude": ["cov_profile/"]
  },
  "fmt": {
    "semiColons": false,
    "lineWidth": 120,
    "exclude": ["**/*.md", "cov_profile/"]
  }
}
